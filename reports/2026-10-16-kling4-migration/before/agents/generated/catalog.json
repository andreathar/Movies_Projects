  "roles": [
    {
      "id": "producer",
      "name": "Producer",
      "brief": "agents/producer.md",
      "skills": [
        "kling-cli",
        "film-editing-qc"
      ],
      "summary": "Own task order, user approvals, actual credit reconciliation and the single paid-submission boundary.",
      "dispatchAuthority": false,
      "paidSubmissionAuthority": true,
      "creativeDecisionAuthority": false
    },
    {
      "id": "director",
      "name": "Director / art director",
      "brief": "agents/director.md",
      "skills": [
        "film-character-continuity",
        "film-dialogue-localization",
        "film-editing-qc"
      ],
      "summary": "Own creative decisions (identity set, wardrobe, grooming, table rule, eye bases, screen axis, script integration, chapter allocation) and record each as a review-decision in `00_brief/decisions/`. Keep documents honest: PROPOSED until decided.",
      "dispatchAuthority": false,
      "paidSubmissionAuthority": false,
      "creativeDecisionAuthority": true
    },
    {
      "id": "continuity",
      "name": "Character continuity reviewer",
      "brief": "agents/continuity.md",
      "skills": [
        "film-character-continuity"
      ],
      "summary": "Audit references, lock the approved character/table bible, review every face-bearing take and diagnose the exact failure window.",
      "dispatchAuthority": false,
      "paidSubmissionAuthority": false,
      "creativeDecisionAuthority": false
    },
    {
      "id": "historian",
      "name": "Historical research reviewer",
      "brief": "agents/historian.md",
      "skills": [
        "grounded-citations"
      ],
      "summary": "Check consequence claims, chronology, quotations and contested reputation language; keep fiction distinct from evidence.",
      "dispatchAuthority": false,
      "paidSubmissionAuthority": false,
      "creativeDecisionAuthority": false
    },
    {
      "id": "dialogue-sound",
      "name": "Dialogue, localization and sound",
      "brief": "agents/dialogue-sound.md",
      "skills": [
        "film-dialogue-localization"
      ],
      "summary": "Maintain stable line IDs, consented voices, native-language targets, measured timing, pronunciation reviews, stems and a proven speech route.",
      "dispatchAuthority": false,
      "paidSubmissionAuthority": false,
      "creativeDecisionAuthority": false
    },
    {
      "id": "storyboard",
      "name": "Storyboard and shot designer",
      "brief": "agents/storyboard.md",
      "skills": [
        "film-character-continuity",
        "film-editing-qc"
      ],
      "summary": "Approve keyframes and an audio-first animatic; enforce the eyes-only contract and tested camera/motion envelope.",
      "dispatchAuthority": false,
      "paidSubmissionAuthority": false,
      "creativeDecisionAuthority": false
    },
    {
      "id": "editor",
      "name": "Editor / finisher",
      "brief": "agents/editor.md",
      "skills": [
        "film-editing-qc"
      ],
      "summary": "Assemble accepted originals, maintain eyelines and table transitions, normalize streams and finish both editions with separate stems/captions.",
      "dispatchAuthority": false,
      "paidSubmissionAuthority": false,
      "creativeDecisionAuthority": false
    },
    {
      "id": "qc",
      "name": "Independent final reviewer",
      "brief": "agents/qc.md",
      "skills": [
        "film-character-continuity",
        "film-dialogue-localization",
        "film-editing-qc"
      ],
      "summary": "Inspect the actual final files end to end; reject face damage, any historical full-face reveal, sync failures and unreviewed language claims.",
      "dispatchAuthority": false,
      "paidSubmissionAuthority": false,
      "creativeDecisionAuthority": false
    },
    {
      "id": "lighting",
      "name": "Lighting and light continuity reviewer",
      "brief": "agents/lighting.md",
      "skills": [
        "film-character-continuity"
      ],
      "summary": "Traduzir emoção e época em luz coerente com o espaço compartilhado. Ler AGENTS.md, estado do filme e a direção de encontros. O detalhamento foi adiado por Andre; preparar apenas quando houver uma atribuição específica.",
      "dispatchAuthority": false,
      "paidSubmissionAuthority": false,
      "creativeDecisionAuthority": false
    },
    {
      "id": "coordinator",
      "name": "Coordinator / dispatcher",
      "brief": "agents/coordinator.md",
      "skills": [],
      "summary": "Organize and route work between film production roles. Read task board state, dependency map and deliveries. Dispatch bounded assignments to available lanes with exact inputs, outputs, verification requirements and blocking conditions. Track acceptance and unblock dependent tasks. Record routing decisions as proposals in its integration handoffs; the producer (director for decision records) writes them to the project decision store.",
      "dispatchAuthority": true,
      "paidSubmissionAuthority": false,
      "creativeDecisionAuthority": false
    }
  ],
