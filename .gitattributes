# Preserve the exact bytes/line endings used by the production hash records.
# Git still displays ordinary text diffs; this disables EOL conversion only.
* -text

# Media and packaged review artifacts use local Git LFS object storage.
*.[pP][nN][gG] filter=lfs diff=lfs merge=lfs -text
